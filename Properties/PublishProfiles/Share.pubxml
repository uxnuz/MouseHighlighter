<?xml version="1.0" encoding="utf-8"?>
<!--
  공유용 exe 만들기 설정.
  - 실행 파일 하나에 .NET과 필요한 파일을 모두 넣어서, .NET이 설치되지 않은 PC에서도 실행됩니다.
  - 결과물은 프로젝트 폴더 맨 위에 MouseHighlighter.exe 하나로 나옵니다.
  사용: dotnet publish -p:PublishProfile=Share  (또는 'exe 다시 만들기.bat' 실행)
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF가 쓰는 네이티브 DLL까지 exe 안에 넣기 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- .pdb 같은 디버그 파일은 만들지 않음 -->
    <DebugType>none</DebugType>
    <!-- 프로젝트 폴더를 직접 출력 위치로 쓰면 소스 파일이 빌드에서 빠지므로,
         bin\share 에 만든 뒤 MouseHighlighter.csproj의 CopyExeToRoot가 맨 위로 복사합니다 -->
    <PublishDir>$(MSBuildProjectDirectory)\bin\share\</PublishDir>
  </PropertyGroup>
</Project>
