<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 트레이 아이콘(NotifyIcon)만 WinForms에서 빌려 씁니다 -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>MouseHighlighter</AssemblyName>
    <RootNamespace>MouseHighlighter</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF와 이름이 겹치지 않도록 WinForms 전역 using은 뺍니다 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- 공유용 exe(Share 프로필)를 만들면 폴더 맨 위로 복사해서 바로 찾을 수 있게 -->
  <Target Name="CopyExeToRoot" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFolder="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
